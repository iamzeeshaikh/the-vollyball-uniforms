---
// Price and order box for a product page.
//
// Reads the SAME `product.price` value that the page's Product/Offer JSON-LD
// uses (see `offerPrice` in src/data/products.ts), and the checkout and
// /api/order re-price from the same file, so the Merchant listing, the page and
// the order can never drift apart. "Add to order" keeps the line in
// localStorage and opens /checkout/. Payment is a PayPal invoice only (sports
// sites rule), sent after the design mockup is approved.
import type { Product } from '../data/products';
import { displayPrice, minQty, MAX_QTY, PAYMENT_LINE } from '../data/products';
import TrustSeals from './TrustSeals.astro';

interface Props {
  product: Product;
  note?: string;
}

const { product, note } = Astro.props;
const min = minQty(product);
---

<div class="mb-6 rounded-lg border border-gray-200 bg-gray-50 px-5 py-4" id="order">
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <!-- Per-unit starting price only; no pack or running total in the order box
         (owner 2026-11-02). The checkout still totals the order. -->
    <span class="text-2xl font-extrabold text-navy-950">Starting from {displayPrice(product)} per {product.priceUnit}</span>
    <span class="text-sm font-semibold text-green-700">Free shipping to the US, UK, Canada and Australia</span>
  </div>
  <p class="mt-1.5 text-sm text-gray-500 leading-relaxed">{note ?? `${PAYMENT_LINE} Nothing is made before you approve it.`}</p>
  <form class="mt-4 grid gap-3 sm:grid-cols-[auto_1fr] sm:items-end" data-tvu-order data-slug={product.slug} data-price={product.price} data-min={min} data-max={MAX_QTY} data-unit={product.priceUnit} action="/checkout/" method="get">
    <label class="grid gap-1 text-xs font-semibold text-gray-600">Quantity
      <input type="number" name="qty" value={min} min={min} max={MAX_QTY} step="1" inputmode="numeric" class="w-28 rounded-md border border-gray-300 px-3 py-2.5 text-base text-navy-950" />
    </label>
    <div class="flex flex-wrap items-center gap-3">
      <input type="hidden" name="add" value={product.slug} />
      <button type="submit" class="inline-flex min-h-[46px] items-center justify-center rounded-lg bg-electric-600 px-6 font-bold text-white hover:bg-electric-700">Add to order</button>
    </div>
  </form>
  {min > 1 && <p class="mt-2 text-xs text-gray-500">Minimum {min} {product.priceUnit}s per order.</p>}
  <p class="mt-2 text-xs text-gray-500">Ordering for a whole club or league? <a href="#quote" class="text-electric-600 underline">Ask for team pricing</a>.</p>
  <div class="mt-4"><TrustSeals /></div>
</div>

<script>
  const KEY = 'tvu-cart';
  for (const f of document.querySelectorAll<HTMLFormElement>('[data-tvu-order]')) {
    const qty = f.querySelector<HTMLInputElement>('input[name="qty"]')!;
    const price = Number(f.dataset.price), min = Number(f.dataset.min), max = Number(f.dataset.max);
    const val = () => Math.min(max, Math.max(min, Math.floor(Number(qty.value) || min)));
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const n = val();
      let cart: { slug: string; qty: number }[] = [];
      try { cart = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch {}
      const slug = f.dataset.slug!;
      const line = cart.find((l) => l.slug === slug);
      if (line) line.qty = n; else cart.push({ slug, qty: n });
      try { localStorage.setItem(KEY, JSON.stringify(cart)); } catch {}
      (window as any).gtag?.('event', 'add_to_cart', { currency: 'USD', value: n * price, items: [{ item_id: slug, quantity: n }] });
      location.href = `/checkout/?add=${encodeURIComponent(slug)}&qty=${n}`;
    });
  }
</script>
