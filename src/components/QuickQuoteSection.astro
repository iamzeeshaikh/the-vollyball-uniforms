---
/**
 * Compact enquiry form for the top of a product page: the five fields a visitor
 * can fill in under a minute, posting to the same endpoint as the full quote
 * form and landing on the thank-you page.
 */
interface Props {
  productName?: string;
  id?: string;
}
const { productName = '', id = 'quick-quote' } = Astro.props;
---

<section id={id} class="py-10 bg-white border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] gap-8 items-start">
      <div>
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-electric-600 mb-3">
          Instant quote
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-navy-950 mb-3">
          Get pricing {productName ? `for ${productName.toLowerCase()}` : 'for your team'}
        </h2>
        <p class="text-gray-600 leading-relaxed mb-5">
          Send your roster size, team colors and artwork — we reply with pricing and a free design
          mockup within 1–2 business hours.
        </p>
        <ul class="space-y-2">
          {[
            'Free full-color design mockup included',
            'Competitive bulk pricing, no hidden fees',
            'Individual player packaging at no extra cost',
          ].map(point => (
            <li class="flex items-start gap-2 text-sm text-gray-700">
              <span class="text-electric-600 font-bold">✓</span>
              {point}
            </li>
          ))}
        </ul>
      </div>

      <form class="bg-gray-50 border border-gray-200 rounded-2xl p-5 space-y-3 min-w-0" data-quick-quote novalidate>
        <input type="hidden" name="product" value={productName} />
        <input type="hidden" name="team" value="Provided in message" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <label class="block min-w-0">
            <span class="block text-sm font-semibold text-gray-700 mb-1">Name *</span>
            <input type="text" name="name" required autocomplete="name" placeholder="Your name"
              class="w-full min-w-0 rounded-lg border border-gray-200 px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-electric-500" />
          </label>
          <label class="block min-w-0">
            <span class="block text-sm font-semibold text-gray-700 mb-1">Email *</span>
            <input type="email" name="email" required autocomplete="email" placeholder="you@team.com"
              class="w-full min-w-0 rounded-lg border border-gray-200 px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-electric-500" />
          </label>
        </div>

        <label class="block min-w-0">
          <span class="block text-sm font-semibold text-gray-700 mb-1">Phone</span>
          <input type="tel" name="phone" autocomplete="tel" placeholder="+1 (555) 000-0000"
            class="w-full min-w-0 rounded-lg border border-gray-200 px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-electric-500" />
        </label>

        <label class="block min-w-0">
          <span class="block text-sm font-semibold text-gray-700 mb-1">Message / instructions</span>
          <textarea name="message" rows="3" placeholder="Roster size, team colors, deadline…"
            class="w-full min-w-0 rounded-lg border border-gray-200 px-4 py-3 text-base resize-none focus:outline-none focus:ring-2 focus:ring-electric-500"></textarea>
        </label>

        <label class="block min-w-0">
          <span class="block text-sm font-semibold text-gray-700 mb-1">
            Upload artwork <span class="font-normal text-gray-500">(optional)</span>
          </span>
          <input type="file" name="artwork" accept=".pdf,.ai,.eps,.svg,.png,.jpg,.jpeg,.zip"
            class="w-full min-w-0 rounded-lg border border-gray-200 px-4 py-2.5 text-sm" />
        </label>

        <p class="hidden rounded-lg bg-red-50 border border-red-200 px-3 py-2 text-sm text-red-700" data-qq-error></p>
        <button type="submit" class="btn-primary w-full justify-center" data-qq-submit>Get my quote →</button>
        <p class="text-xs text-gray-500 text-center">We respond within 1–2 business hours. No spam, ever.</p>
      </form>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-quick-quote]').forEach((form) => {
    const error = form.querySelector<HTMLElement>('[data-qq-error]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-qq-submit]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      error.classList.add('hidden');
      submit.disabled = true;
      submit.textContent = 'Sending…';

      try {
        const res = await fetch('/api/quote/', { method: 'POST', body: new FormData(form) });
        const json = await res.json();
        if (json.success) {
          window.location.href = '/thank-you/';
          return;
        }
        throw new Error(json.error ?? 'Unknown error');
      } catch (err) {
        error.textContent =
          err instanceof Error
            ? `${err.message} — please try again or email Info@thevolleyballuniforms.com.`
            : 'Could not send. Please try again.';
        error.classList.remove('hidden');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Get my quote →';
      }
    });
  });
</script>
