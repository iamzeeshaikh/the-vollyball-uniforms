---
interface Props {
  images: string[];
  productName: string;
}

const { images, productName } = Astro.props;

// scripts/optimize-images.mjs writes a 900px main view and a 220px thumbnail
// next to each source photo, so a phone never pulls five full-size JPEGs.
const rendition = (src: string, suffix: string) => src.replace(/\.(jpe?g|png)$/i, `${suffix}.webp`);
---

<div class="space-y-4">
  <!-- Main image -->
  <div class="aspect-square md:aspect-[4/3] overflow-hidden rounded-2xl bg-gray-100">
    <img
      id="gallery-main"
      src={rendition(images[0], '-900')}
      alt={`${productName} - Main product view`}
      class="w-full h-full object-cover"
      width="800"
      height="600"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <!-- Thumbnails -->
  <div class="grid grid-cols-5 gap-2">
    {images.map((img, i) => (
      <button
        type="button"
        aria-label={`View image ${i + 1}`}
        aria-current={i === 0 ? 'true' : 'false'}
        class={`gallery-thumb aspect-square overflow-hidden rounded-lg border-2 hover:border-electric-500 transition-all ${i === 0 ? 'border-electric-500' : 'border-transparent'}`}
        data-src={rendition(img, '-900')}
        data-alt={`${productName} - View ${i + 1}`}
      >
        <img
          src={rendition(img, '-220')}
          alt={`${productName} - Thumbnail ${i + 1}`}
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
          width="160"
          height="160"
        />
      </button>
    ))}
  </div>
</div>

<script>
  const main = document.getElementById('gallery-main') as HTMLImageElement;
  const thumbs = document.querySelectorAll('.gallery-thumb');

  // Warm the other views once the page is idle so a thumbnail click swaps the
  // main image instantly instead of waiting on a fresh download.
  const warmed = new Set<string>();
  const warmSrc = (src: string | null) => {
    if (!src || warmed.has(src)) return;
    warmed.add(src);
    const img = new Image();
    img.fetchPriority = 'low';
    img.decoding = 'async';
    img.src = src;
  };
  const warm = () => {
    thumbs.forEach(thumb => warmSrc(thumb.getAttribute('data-src')));
  };
  const scheduleWarm = () => {
    if ('requestIdleCallback' in window) requestIdleCallback(warm);
    else setTimeout(warm, 400);
  };
  if (document.readyState === 'complete') scheduleWarm();
  else window.addEventListener('load', scheduleWarm);

  thumbs.forEach(thumb => {
    // Hover/touch warming: start the fetch before the click even lands.
    thumb.addEventListener('pointerenter', () => warmSrc(thumb.getAttribute('data-src')));
    thumb.addEventListener('touchstart', () => warmSrc(thumb.getAttribute('data-src')), { passive: true });

    thumb.addEventListener('click', () => {
      const src = thumb.getAttribute('data-src');
      const alt = thumb.getAttribute('data-alt');
      if (main && src) {
        main.src = src;
        main.alt = alt || '';
      }
      thumbs.forEach(t => {
        t.classList.remove('border-electric-500');
        t.classList.add('border-transparent');
        t.setAttribute('aria-current', 'false');
      });
      thumb.classList.remove('border-transparent');
      thumb.classList.add('border-electric-500');
      thumb.setAttribute('aria-current', 'true');
    });
  });
</script>
