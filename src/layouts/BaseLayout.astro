---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: object | object[];
}

const props = Astro.props;
import WhatsAppButton from '../components/WhatsAppButton.astro'
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SEOHead {...props} />
    <meta name="google-site-verification" content="hjG_MMZAmnmUecRepnjaPiUiS43xpZx8oFSXSZrzSNw" />
    {/* The hero copy is the LCP element on mobile. Without this the font is only
        discovered once the CSS parses, and the swap repaint pushed LCP past 3.5s. */}
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-382HJ6SXJC"></script>
    <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-382HJ6SXJC');</script>
    <script is:inline defer src="/ga4-events.js"></script>
    <!-- Microsoft Clarity -->
    <script is:inline>(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","yk7eoybep1");</script>
  </head>
  <body class="bg-white">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- Chat widget loads after the page is interactive so it stays out of the
         critical path and off the main thread during first paint. -->
    <script is:inline>
      (function () {
        var load = function () {
          var s = document.createElement('script');
          s.src = 'https://chat.zeeops.dev/widget.js?siteId=volleyballuniforms';
          s.async = true;
          document.body.appendChild(s);
        };
        if (document.readyState === 'complete') setTimeout(load, 1200);
        else window.addEventListener('load', function () { setTimeout(load, 1200); });
      })();
    </script>
    <!-- WhatsApp: bottom-LEFT, because the ZeeOps chat widget owns bottom-right.
       The prefilled text names this site, since one WhatsApp number serves all
       five sports sites and nothing else in the message would tell them apart. -->
  <WhatsAppButton text="Hi! I'd like a quote for custom volleyball uniforms." />
  </body>
</html>
