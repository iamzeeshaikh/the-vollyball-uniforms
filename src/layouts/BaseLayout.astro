---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: object | object[];
}

const props = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SEOHead {...props} />
    <meta name="google-site-verification" content="hjG_MMZAmnmUecRepnjaPiUiS43xpZx8oFSXSZrzSNw" />
    {/* The hero copy is the LCP element on mobile. Without this the font is only
        discovered once the CSS parses, and the swap repaint pushed LCP past 3.5s. */}
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-white">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
