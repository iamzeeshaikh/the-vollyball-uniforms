---
// Checkout: lines come from the visitor's browser (localStorage, set by the order box in
// ProductPrice.astro); prices come from src/data/products.ts and /api/order re-prices them.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, minQty, MAX_QTY, PAYMENT_LINE } from '../../data/products';
const catalog = Object.fromEntries(products.map((p) => [p.slug, { t: p.name, p: p.price, u: p.priceUnit, m: minQty(p), i: p.images[0] ?? '' }]));
const cfg = { catalog, max: MAX_QTY };
const input = 'w-full rounded-md border border-gray-300 px-3 py-2.5 text-base text-navy-950';
const label = 'grid gap-1 text-sm font-semibold text-gray-700';
---
<BaseLayout title="Checkout | The Volleyball Uniforms" description="Place your custom volleyball uniform order with free US shipping. Pay by PayPal invoice after you approve your free design mockup." canonical="https://thevolleyballuniforms.com/checkout/" noindex={true}>
  <section class="py-12 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-extrabold text-navy-950 mb-2">Checkout</h1>
      <p class="text-gray-600 max-w-3xl">Free shipping in the US. We email a free design mockup first; nothing is made or charged before you approve it. {PAYMENT_LINE}</p>
      <form id="tvu-co-form" novalidate class="mt-8 grid gap-8 lg:grid-cols-[1.4fr_1fr] items-start">
        <div class="grid gap-6">
          <fieldset class="grid gap-4 sm:grid-cols-2 rounded-xl border border-gray-200 bg-white p-5">
            <legend class="px-2 font-bold text-navy-950">Your details</legend>
            <label class={`${label} sm:col-span-2`}>Full name<input name="name" autocomplete="name" required maxlength="120" class={input} /></label>
            <label class={label}>Email<input name="email" type="email" autocomplete="email" required maxlength="180" class={input} /></label>
            <label class={label}>Phone<input name="phone" type="tel" autocomplete="tel" required maxlength="40" class={input} /></label>
            <label class={`${label} sm:col-span-2`}>Team, school or club (optional)<input name="company" autocomplete="organization" maxlength="140" class={input} /></label>
          </fieldset>
          <fieldset class="grid gap-4 sm:grid-cols-2 rounded-xl border border-gray-200 bg-white p-5">
            <legend class="px-2 font-bold text-navy-950">Shipping address (United States)</legend>
            <label class={`${label} sm:col-span-2`}>Address<input name="address1" autocomplete="address-line1" required maxlength="200" class={input} /></label>
            <label class={`${label} sm:col-span-2`}>Apartment, suite (optional)<input name="address2" autocomplete="address-line2" maxlength="200" class={input} /></label>
            <label class={label}>City<input name="city" autocomplete="address-level2" required maxlength="100" class={input} /></label>
            <label class={label}>State<input name="region" autocomplete="address-level1" required maxlength="60" class={input} /></label>
            <label class={label}>ZIP code<input name="postal" autocomplete="postal-code" required maxlength="20" class={input} /></label>
            <p class="text-xs text-gray-500 sm:col-span-2 self-end">Outside the US? <a class="text-electric-600 underline" href="/request-a-quote/">Request a quote</a> with your country.</p>
          </fieldset>
          <fieldset class="grid gap-4 rounded-xl border border-gray-200 bg-white p-5">
            <legend class="px-2 font-bold text-navy-950">Design and roster</legend>
            <label class={label}>Logo, design or roster file (optional, up to 4 MB)<input name="artwork" type="file" accept=".pdf,.ai,.eps,.svg,.png,.jpg,.jpeg,.zip,.csv,.xlsx" class="text-sm" /></label>
            <label class={label}>Notes: colors, names and numbers, sizes, game date (optional)<textarea name="notes" rows="4" maxlength="3000" class={input}></textarea></label>
          </fieldset>
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
        </div>
        <aside class="rounded-xl border border-gray-200 bg-white p-5 lg:sticky lg:top-24">
          <h2 class="text-lg font-bold text-navy-950 mb-3">Your order</h2>
          <div data-lines class="divide-y divide-gray-100 text-sm"><p class="py-2">Your order is empty. <a class="text-electric-600 underline" href="/volleyball-jerseys/">Choose uniforms</a></p></div>
          <div class="mt-3 border-t border-gray-200 pt-3 text-sm grid gap-1">
            <div class="flex justify-between"><span>Shipping</span><span class="font-semibold text-green-700">Free</span></div>
            <div class="flex justify-between text-base"><strong>Total</strong><strong data-grand>$0.00</strong></div>
          </div>
          <div class="mt-4 rounded-lg bg-gray-50 p-3 text-sm text-gray-700"><strong>Payment: PayPal invoice.</strong> We email it after you approve your design mockup. Production starts when it is paid.</div>
          <p class="mt-3 min-h-[1em] text-sm text-red-700" data-err role="alert"></p>
          <button type="submit" data-place disabled class="mt-1 w-full min-h-[50px] rounded-lg bg-electric-600 font-bold text-white hover:bg-electric-700 disabled:opacity-60">Place order</button>
          <p class="mt-3 text-xs text-gray-500">By placing the order you agree to our <a class="underline" href="/terms-and-conditions/">terms</a>, <a class="underline" href="/shipping-policy/">shipping policy</a> and <a class="underline" href="/refund-policy/">refund policy</a>.</p>
        </aside>
      </form>
    </div>
  </section>
  <script is:inline define:vars={{ cfg }}>window.TVU_CHECKOUT = cfg;</script>
  <script is:inline src="/tvu-checkout.js" defer></script>
</BaseLayout>
